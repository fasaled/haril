{
  "name": "haril-ts",
  "version": "0.1.3",
  "description": "File-lifecycle reconstruction for Windows, in TypeScript + Node-API",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run packages/cli/src/cli.ts",
    "tui": "bun run packages/cli/src/cli.ts",
    "mcp": "bun run packages/cli/src/cli.ts mcp",
    "build:js": "bun build packages/cli/src/cli.ts --outfile dist/haril.js --target bun --format esm --packages=external",
    "build:native": "powershell -ExecutionPolicy Bypass -File ./native/build-windows.ps1 -Platform x64",
    "build:native:arm64": "powershell -ExecutionPolicy Bypass -File ./native/build-windows.ps1 -Platform arm64",
    "build:native:all": "powershell -ExecutionPolicy Bypass -File ./native/build-windows.ps1 -AllPlatforms",
    "build:exe": "bun run build:standalone",
    "build:native:host": "bun run scripts/build-native-host.ts",
    "build:package": "bun run build:native:host && bun run scripts/build-distribution.ts package",
    "pack:package": "bun run build:package && npm pack ./packages/cli",
    "build:standalone": "bun run scripts/build-distribution.ts standalone",
    "build": "bun run build:js && bun run build:native:host && bun run build:standalone",
    "lint": "biome lint packages scripts",
    "format": "biome format --write packages scripts",
    "format:check": "biome format packages scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0",
    "react-devtools-core": "^8.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@haril-ts/core": "workspace:*",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "node-api-headers": "^1.9.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "bun": ">=1.3.0 <2",
    "node": ">=22.5.0"
  },
  "os": ["win32", "linux", "darwin"]
}