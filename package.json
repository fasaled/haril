{
  "name": "haril-ts",
  "version": "0.1.0",
  "description": "File-lifecycle reconstruction for Windows, in Bun + TypeScript",
  "type": "module",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run packages/cli/src/cli.ts",
    "tui": "bun run packages/cli/src/cli.ts",
    "mcp": "bun run packages/cli/src/cli.ts mcp",
    "build:native": "powershell -ExecutionPolicy Bypass -File native/build-windows.ps1 -Platform x64",
    "build:native:arm64": "powershell -ExecutionPolicy Bypass -File native/build-windows.ps1 -Platform arm64",
    "build:js": "bun build packages/cli/src/cli.ts --outfile dist/haril.js --target node --format esm --packages=external",
    "build": "bun run build:js && bun build --compile dist/haril.js --target=bun-windows-x64 --outfile dist/haril.exe",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "node-api-headers": "^1.9.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0",
    "react-devtools-core": "^8.0.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  },
  "os": ["win32"]
}