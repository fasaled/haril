{
  "name": "@fasaled/haril",
  "version": "0.1.2",
  "description": "File-lifecycle reconstruction and analysis CLI",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fasaled/haril-ts.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/fasaled/haril-ts",
  "engines": {
    "node": ">=22.5.0"
  },
  "os": ["win32", "linux", "darwin"],
  "bin": { "haril": "./dist/cli.js" },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --outfile dist/cli.js --target node --format esm --packages bundle",
    "prepack": "bun run --cwd ../.. build:package",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  }
}